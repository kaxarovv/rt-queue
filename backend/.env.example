# --- Database ---
DATABASE_URL=postgresql+psycopg://rtq:rtq_dev_password@localhost:5433/rtq_db

# --- Object storage (MinIO, S3-совместимое) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=rtq_minio
S3_SECRET_KEY=rtq_minio_password
S3_BUCKET_NAME=source-documents

# --- LLM: любой OpenAI-совместимый эндпоинт (LM Studio локально ИЛИ облачный
# провайдер) -- код не меняется, меняются только эти три значения.
#
# Вариант 1 (по умолчанию): локальный LM Studio, ключ не нужен.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL_NAME=qwen2.5-32b-instruct
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
#
# Вариант 2: облачный Groq (бесплатный тариф, OpenAI-совместимый API,
# поддерживает response_format с json_schema). Получить ключ: console.groq.com
# -> API Keys. Список моделей, доступных вашему ключу: GET /v1/models с
# заголовком Authorization -- он периодически меняется, проверяйте перед
# использованием. На момент проверки работал openai/gpt-oss-120b (structured
# output на русскоязычном тексте прошёл чисто). Раскомментировать и заполнить
# LLM_API_KEY вместо блока выше:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL_NAME=openai/gpt-oss-120b
# LLM_API_KEY=gsk_...
# LLM_TIMEOUT_SECONDS=120

# --- Ёмкость аппарата ЛТ (стартовые значения, потом переносим в БД-конфиг) ---
MACHINE_SESSIONS_PER_DAY=8
MACHINE_WORKING_DAYS_PER_WEEK=5

# --- App ---
APP_ENV=development
DEBUG=true
